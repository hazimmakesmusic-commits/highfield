# --- Login (required) ---
# The one password that unlocks the studio.
OWNER_PASSWORD=
# Random string, 32+ characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Replicate (required) --- https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Media storage ---
# Cloudflare R2 (or any S3-compatible bucket). Required on Vercel.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=afterimage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Leave the S3_* vars empty to store everything in a local folder instead (laptop use only):
# DATA_DIR=./data
