# ===== Required =====
# The one password that unlocks your studio.
OWNER_PASSWORD=
# Any long random text, 32+ characters (used to sign your login cookie).
SESSION_SECRET=

# ===== Storage: Cloudflare R2 (free up to 10 GB) =====
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=afterimage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Leave the S3_* lines empty to save into a local ./data folder instead (only when running on your own computer).

# ===== Free AI (recommended) =====
# Hugging Face token (free account): unlocks free video, lip sync and upscaling. https://huggingface.co/settings/tokens
HF_TOKEN=
# Pollinations key (free account, sign in with GitHub): unlocks better free image models. https://enter.pollinations.ai
POLLINATIONS_API_KEY=

# ===== Paid AI (optional) =====
# Replicate token: unlocks the paid models (Kling, Veo, Topaz, OmniHuman...). Leave empty to stay 100% free.
REPLICATE_API_TOKEN=
